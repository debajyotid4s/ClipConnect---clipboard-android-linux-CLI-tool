[Unit]
Description=ClipConnect clipboard sync daemon (user)
Documentation=https://github.com/debajyotid4s/ClipConnect---clipboard-android-linux-CLI-tool
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/clipconnect daemon
Restart=on-failure
RestartSec=2
# Run as the normal user — the daemon must access the user's graphical
# clipboard session; never run it as root.
Environment=XDG_AUTOSTART=1

[Install]
WantedBy=default.target
