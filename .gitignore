# Build outputs
laptop/laptop/
laptop/clipconnect
_pkg/
android/build/
android/.gradle/
android/*.apk
android/app/build/
android/app/tmp/

# Test artifacts (reports, results)
android/app/src/test/
android/app/src/androidTest/
*/test-results/
*/build/reports/

# Go test files (keep non-test source)
*_test.go
*.test

# Kotlin test files (keep non-test source)
*Test*.kt

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
/tmp/*

# Docs (markdown) — ignored, see ROOT.md for the overview
*.md

# Essential protocol spec (kept: it is the wire-contract, not prose)
!protocol/SPEC.md
!ROOT.md

# Secrets
*.secret
*.key
.env

# Local runtime/config noise
*.local
~
*.tmp
